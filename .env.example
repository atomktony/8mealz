# Supabase (connect via Vercel > Storage > Supabase integration)
# Without these, the site runs in demo mode: form data is kept in memory and resets.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page (/admin)
ADMIN_PASSWORD=change-me

# Optional: email alert for each new signup, application and order (Resend)
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=8Mealz <onboarding@resend.dev>

# Public site URL, used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://8mealz.vercel.app
